{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Llm": {
    "Provider": "OpenAiCompatible",
    "ClaudeCli": {
      "Model": "haiku",
      "TimeoutSeconds": 120,
      "MaxConcurrency": 1
    },
    "BaseUrl": "http://localhost:11434/v1",
    "ApiKey": "local",
    "ChatModel": "qwen3:4b-instruct",
    "EmbeddingModel": "bge-m3"
  },
  "Rag": {
    "QdrantHost": "localhost",
    "QdrantPort": 6334,
    "Collection": "runbooks",
    "SearchMode": "Hybrid",
    "SparseWeight": 0.5,
    "TopK": 5,
    "MinScore": 0.48,
    "RerankerUrl": "http://localhost:8081/",
    "RerankCandidates": 20,
    "RerankMinScore": 0.02
  }
}
